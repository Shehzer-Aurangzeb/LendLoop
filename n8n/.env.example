# Encrypts the credentials n8n stores in its volume. Make one with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=
# Shared HMAC secret: same value as N8N_WEBHOOK_SECRET in Convex and the n8n Crypto credential.
# Only scripts/send-test-notification.sh reads it from here; docker-compose.yml does not pass it to n8n.
LENDLOOP_WEBHOOK_SECRET=
