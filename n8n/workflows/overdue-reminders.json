{
  "id": "LendLoopOverdue1",
  "name": "LendLoop overdue reminders",
  "nodes": [
    {
      "id": "d7a0b5c2-0001-4000-8000-000000000001",
      "name": "Every day at 09:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 9,
              "triggerAtMinute": 0
            }
          ]
        }
      }
    },
    {
      "id": "d7a0b5c2-0011-4000-8000-000000000011",
      "name": "Run now",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        200
      ],
      "parameters": {}
    },
    {
      "id": "d7a0b5c2-0002-4000-8000-000000000002",
      "name": "Build due request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "// The one place to change if Convex is not on this machine's port 3211.\nconst convexSiteUrl = 'http://host.docker.internal:3211'\n\n// The exact string that is signed is the one that is sent.\nreturn [{ json: { convexSiteUrl, body: JSON.stringify({ sentAt: Date.now() }) } }]\n"
      }
    },
    {
      "id": "d7a0b5c2-0003-4000-8000-000000000003",
      "name": "Sign due request",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "action": "hmac",
        "binaryData": false,
        "type": "SHA256",
        "value": "={{ $json.body }}",
        "dataPropertyName": "signature",
        "encoding": "hex"
      },
      "credentials": {
        "crypto": {
          "id": "LendLoopCvxKey01",
          "name": "LendLoop Convex secret"
        }
      }
    },
    {
      "id": "d7a0b5c2-0004-4000-8000-000000000004",
      "name": "Fetch due reminders",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Build due request').first().json.convexSiteUrl }}/overdue-reminders/due",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-LendLoop-Signature",
              "value": "={{ $json.signature }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.body }}",
        "options": {
          "timeout": 10000
        }
      }
    },
    {
      "id": "d7a0b5c2-0005-4000-8000-000000000005",
      "name": "One item per reminder",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        880,
        0
      ],
      "parameters": {
        "fieldToSplitOut": "reminders",
        "include": "selectedOtherFields",
        "fieldsToInclude": "date",
        "options": {
          "destinationFieldName": "reminder"
        }
      }
    },
    {
      "id": "d7a0b5c2-0006-4000-8000-000000000006",
      "name": "Send mock reminder",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "jsCode": "// Set to true to demo a failed send: n8n retries it, then the error branch writes 'failed'.\nconst isFailingOnPurpose = false\n\nif (isFailingOnPurpose) throw new Error('Mock reminder send failed on purpose.')\n\nreturn $input.all().map(({ json }) => {\n  const { borrowerFirstName, toolName, endDate } = json.reminder\n  const message = `To ${borrowerFirstName}: please return ${toolName}, it was due ${endDate}`\n\n  console.log(message)\n\n  return { json: { ...json, message } }\n})\n"
      },
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "id": "d7a0b5c2-0007-4000-8000-000000000007",
      "name": "Build sent result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        -100
      ],
      "parameters": {
        "jsCode": "return $input.all().map(({ json }) => ({\n  json: {\n    body: JSON.stringify({ loanId: json.reminder.loanId, date: json.date, outcome: 'sent', sentAt: Date.now() }),\n  },\n}))\n"
      }
    },
    {
      "id": "d7a0b5c2-0008-4000-8000-000000000008",
      "name": "Build failed result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        100
      ],
      "parameters": {
        "jsCode": "// A throw gives one error item, paired to the first loan only, so build one failed body per reminder from the split.\nreturn $('One item per reminder').all().map(({ json }) => ({\n  json: {\n    body: JSON.stringify({ loanId: json.reminder.loanId, date: json.date, outcome: 'failed', sentAt: Date.now() }),\n  },\n}))\n"
      }
    },
    {
      "id": "d7a0b5c2-0009-4000-8000-000000000009",
      "name": "Sign sent result",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 2,
      "position": [
        1540,
        -100
      ],
      "parameters": {
        "action": "hmac",
        "binaryData": false,
        "type": "SHA256",
        "value": "={{ $json.body }}",
        "dataPropertyName": "signature",
        "encoding": "hex"
      },
      "credentials": {
        "crypto": {
          "id": "LendLoopCvxKey01",
          "name": "LendLoop Convex secret"
        }
      }
    },
    {
      "id": "d7a0b5c2-0010-4000-8000-000000000010",
      "name": "Write back sent result",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1760,
        -100
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Build due request').first().json.convexSiteUrl }}/overdue-reminders/result",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-LendLoop-Signature",
              "value": "={{ $json.signature }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.body }}",
        "options": {
          "timeout": 10000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "id": "d7a0b5c2-0012-4000-8000-000000000012",
      "name": "Sign failed result",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 2,
      "position": [
        1540,
        100
      ],
      "parameters": {
        "action": "hmac",
        "binaryData": false,
        "type": "SHA256",
        "value": "={{ $json.body }}",
        "dataPropertyName": "signature",
        "encoding": "hex"
      },
      "credentials": {
        "crypto": {
          "id": "LendLoopCvxKey01",
          "name": "LendLoop Convex secret"
        }
      }
    },
    {
      "id": "d7a0b5c2-0013-4000-8000-000000000013",
      "name": "Write back failed result",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1760,
        100
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Build due request').first().json.convexSiteUrl }}/overdue-reminders/result",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-LendLoop-Signature",
              "value": "={{ $json.signature }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.body }}",
        "options": {
          "timeout": 10000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "id": "d7a0b5c2-0014-4000-8000-000000000014",
      "name": "Fail run: reminders failed",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        100
      ],
      "parameters": {
        "jsCode": "// Runs after the failed rows are saved, so the run ends in error and the error workflow alerts.\nthrow new Error(`${$input.all().length} overdue reminder(s) failed after every retry and were written back as failed.`)\n"
      }
    }
  ],
  "connections": {
    "Every day at 09:00": {
      "main": [
        [
          {
            "node": "Build due request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run now": {
      "main": [
        [
          {
            "node": "Build due request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build due request": {
      "main": [
        [
          {
